<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#ffe5ef">
<title>Мини-свидание 💗</title>
<style>
  :root {
    --pink: #ffe5ef;
    --pink-deep: #f7b6ce;
    --rose: #c65b83;
    --text: #62364a;
    --white: #fffafd;
    --shadow: 0 14px 40px rgba(163, 78, 112, .13);
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--text);
    background:
      radial-gradient(circle at 15% 15%, rgba(255,255,255,.85) 0 3px, transparent 4px),
      radial-gradient(circle at 85% 25%, rgba(255,255,255,.7) 0 4px, transparent 5px),
      linear-gradient(145deg, #fff0f5, var(--pink) 55%, #ffd9e8);
    background-size: 46px 46px, 61px 61px, auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 22px 14px;
    overflow-x: hidden;
  }
  .decor {
    position: fixed; pointer-events: none; opacity: .45;
    font-size: 22px; animation: float 7s ease-in-out infinite;
  }
  .d1 { top: 8%; left: 7%; } .d2 { top: 18%; right: 8%; animation-delay: -2s; }
  .d3 { bottom: 12%; left: 9%; animation-delay: -4s; } .d4 { bottom: 9%; right: 10%; animation-delay: -1s; }
  @keyframes float { 0%,100% { transform: translateY(0) rotate(-5deg); } 50% { transform: translateY(-12px) rotate(6deg); } }
  .app {
    width: min(100%, 520px);
    position: relative;
  }
  .progress {
    display: flex; gap: 7px; justify-content: center; margin: 0 auto 18px;
  }
  .dot { width: 22px; height: 5px; border-radius: 20px; background: rgba(198,91,131,.2); transition: .25s; }
  .dot.active { width: 34px; background: var(--rose); }
  .screen {
    display: none;
    background: rgba(255,250,253,.86);
    border: 1px solid rgba(255,255,255,.9);
    box-shadow: var(--shadow);
    border-radius: 28px;
    padding: clamp(26px, 7vw, 42px) clamp(20px, 6vw, 34px);
    text-align: center;
    min-height: 360px;
    animation: enter .38s ease both;
    backdrop-filter: blur(8px);
  }
  .screen.active { display: flex; flex-direction: column; justify-content: center; align-items: center; }
  @keyframes enter { from { opacity: 0; transform: translateY(10px) scale(.99); } to { opacity: 1; transform: translateY(0) scale(1); } }
  h1, h2, p { margin-top: 0; }
  h1 { font-size: clamp(28px, 7vw, 39px); line-height: 1.2; margin-bottom: 24px; letter-spacing: -.7px; }
  h2 { font-size: clamp(24px, 6vw, 32px); line-height: 1.25; margin-bottom: 17px; }
  p { font-size: 17px; line-height: 1.6; margin-bottom: 18px; }
  .small { font-size: 15px; opacity: .85; }
  .buttons { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; width: 100%; margin-top: 8px; }
  button, .fake-button {
    appearance: none; border: 0; cursor: pointer; text-decoration: none;
    border-radius: 999px; padding: 14px 23px; min-height: 48px;
    background: linear-gradient(135deg, #e88eb0, #d66f99);
    color: white; font: inherit; font-size: 16px; font-weight: 650;
    box-shadow: 0 7px 16px rgba(198,91,131,.22);
    transition: transform .15s, box-shadow .15s, background .15s;
  }
  button:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(198,91,131,.25); }
  button:active { transform: scale(.98); }
  button.secondary { background: #fff; color: var(--rose); border: 1px solid #f1bfd1; box-shadow: none; }
  .emoji { font-size: 35px; margin-bottom: 15px; }
  .quote { font-size: clamp(21px, 5.5vw, 28px); line-height: 1.45; }
  .aside { font-style: italic; font-size: 18px; margin-top: 2px; }
  .date-wrap { width: 100%; max-width: 330px; margin: 10px auto 14px; }
  input[type="date"] {
    width: 100%; padding: 14px 15px; border: 1px solid #e9b4c9; border-radius: 15px;
    background: white; color: var(--text); font: inherit; font-size: 17px;
  }
  .hint { font-size: 13px; opacity: .7; margin: 5px 0 15px; }
  .movie-list { display: grid; gap: 11px; width: 100%; margin: 7px 0 18px; }
  .movie {
    display: flex; align-items: center; gap: 13px; text-align: left; width: 100%;
    padding: 10px; border-radius: 17px; background: #fff;
    border: 1.5px solid #f0cada; box-shadow: none; color: var(--text);
    font-weight: 500; min-height: 112px;
  }
  .movie.selected { border-color: var(--rose); background: #fff0f6; box-shadow: 0 0 0 3px rgba(198,91,131,.12); }
  .poster {
    flex: 0 0 70px; width: 70px; height: 96px; border-radius: 10px;
    display: block; object-fit: cover; object-position: center;
    background: linear-gradient(145deg,#f9d5e3,#f3a9c4);
    box-shadow: 0 3px 9px rgba(100,40,65,.12);
  }
  .movie-title { flex: 1; font-weight: 650; line-height: 1.35; }
  .movie-sub { display: block; font-size: 12px; font-weight: 400; opacity: .7; margin-top: 6px; line-height: 1.4; }
  .radio { width: 20px; height: 20px; border: 2px solid #dca1b8; border-radius: 50%; flex: 0 0 20px; position: relative; }
  .movie.selected .radio { border-color: var(--rose); }
  .movie.selected .radio::after { content:""; position:absolute; inset:4px; border-radius:50%; background:var(--rose); }
  .footer-note { font-size: 12px; opacity: .6; margin-top: 16px; }
  .final-kiss { font-size: 44px; margin-bottom: 16px; }
  .error { color: #a23b63; font-size: 14px; margin: 8px 0 0; min-height: 20px; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
</style>
</head>
<body>
  <span class="decor d1">♡</span><span class="decor d2">✿</span>
  <span class="decor d3">♡</span><span class="decor d4">✧</span>
  <main class="app">
    <div class="progress" aria-label="Прогресс">
      <span class="dot active"></span><span class="dot"></span><span class="dot"></span>
      <span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span>
    </div>

    <section class="screen active" data-screen="0">
      <div class="emoji">🌸</div>
      <h1>Ты пойдёшь со мной на мини-свидание? 💕</h1>
      <div class="buttons">
        <button onclick="goTo(1)">Да!</button>
        <button onclick="goTo(1)">ДАА</button>
      </div>
    </section>

    <section class="screen" data-screen="1">
      <div class="emoji">🤭</div>
      <h2>Ну ты понял, что отказы не принимаются</h2>
      <div class="buttons"><button onclick="goTo(2)">Понял, принцесса</button></div>
    </section>

    <section class="screen" data-screen="2">
      <div class="emoji">💋</div>
      <p class="quote">Я очень хочу провести вечер с Вами, сударь 💋</p>
      <p class="aside">(Ну и всю жизнь тоже, кстати ❤️)</p>
      <div class="buttons"><button onclick="goTo(3)">И что же Вы задумали, сударыня?</button></div>
    </section>

    <section class="screen" data-screen="3">
      <div class="emoji">🍿</div>
      <h2>В программе нашего вечера: я, Вы и большой экран 🍿</h2>
      <div class="buttons"><button onclick="goTo(4)">Согласен</button></div>
    </section>

    <section class="screen" data-screen="4">
      <div class="emoji">📅</div>
      <h2>Ну что, выбираем дату? 🎬</h2>
      <p>Выбери день, когда тебе будет удобно ❤️</p>
      <div class="date-wrap">
        <input id="datePicker" type="date" aria-label="Выбери дату">
        <div class="hint">Можно выбрать любую дату.</div>
      </div>
      <div class="buttons"><button onclick="saveDateAndContinue()">Дальше</button></div>
      <div class="error" id="dateError" role="status"></div>
    </section>

    <section class="screen" data-screen="5">
      <div class="emoji">🍿🎬</div>
      <h2>Ну а теперь самое интересное… 🍿🎬</h2>
      <p><strong>Что будем смотреть?</strong></p>
      <div class="movie-list" id="movieList">
        <button class="movie" type="button" data-movie="Романовы: преданность и предательство" onclick="selectMovie(this)">
          <img class="poster" src="https://media.kg-portal.ru/movies/r/romanovypredannostipredatelstvo/posters/romanovypredannostipredatelstvo_1.jpg" alt="Постер фильма «Романовы: преданность и предательство»" onerror="this.style.display='none'; this.insertAdjacentHTML('afterend','<span class=&quot;poster&quot; style=&quot;display:grid;place-items:center;font-size:24px&quot;>👑</span>')">
          <span class="movie-title">Романовы: преданность и предательство<span class="movie-sub">Драма · История</span></span><span class="radio"></span>
        </button>
        <button class="movie" type="button" data-movie="Девятая планета" onclick="selectMovie(this)">
          <img class="poster" src="https://media.kg-portal.ru/movies/d/devjatajaplaneta/posters/devjatajaplaneta_1.jpg" alt="Постер фильма «Девятая планета»" onerror="this.style.display='none'; this.insertAdjacentHTML('afterend','<span class=&quot;poster&quot; style=&quot;display:grid;place-items:center;font-size:24px&quot;>🚀</span>')">
          <span class="movie-title">Девятая планета<span class="movie-sub">Фантастика · Боевик</span></span><span class="radio"></span>
        </button>
        <button class="movie" type="button" data-movie="Битва моторов" onclick="selectMovie(this)">
          <img class="poster" src="https://media.kg-portal.ru/movies/b/bitvamotorov/posters/bitvamotorov_1o.jpg" alt="Постер фильма «Битва моторов»" onerror="this.style.display='none'; this.insertAdjacentHTML('afterend','<span class=&quot;poster&quot; style=&quot;display:grid;place-items:center;font-size:24px&quot;>🏎️</span>')">
          <span class="movie-title">Битва моторов<span class="movie-sub">Приключения · Драма</span></span><span class="radio"></span>
        </button>
      </div>
      <div class="buttons"><button onclick="confirmMovie()">Мой выбор</button></div>
      <div class="error" id="movieError" role="status"></div>
      <p class="footer-note">После выбора можно отправить дату и фильм через меню «Поделиться» на телефоне.</p>
    </section>

    <section class="screen" data-screen="6">
      <div class="final-kiss">💋</div>
      <h1>До встречи, любимый!</h1>
      <p class="small" id="summary"></p>
      <div class="buttons">
        <button onclick="shareChoice()">Отправить мой выбор</button>
        <button class="secondary" onclick="goTo(0)">Посмотреть ещё раз</button>
      </div>
      <p class="footer-note">Нажми «Отправить мой выбор», чтобы поделиться выбранной датой и фильмом.</p>
    </section>
  </main>

<script>
  let chosenDate = "";
  let chosenMovie = "";
  let currentScreen = 0;

  function goTo(index) {
    document.querySelectorAll(".screen").forEach((screen, i) => {
      screen.classList.toggle("active", i === index);
    });
    document.querySelectorAll(".dot").forEach((dot, i) => dot.classList.toggle("active", i === index));
    currentScreen = index;
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function saveDateAndContinue() {
    const picker = document.getElementById("datePicker");
    const error = document.getElementById("dateError");
    if (!picker.value) {
      error.textContent = "Сначала выбери дату 🙂";
      return;
    }
    chosenDate = picker.value;
    error.textContent = "";
    goTo(5);
  }

  function selectMovie(button) {
    document.querySelectorAll(".movie").forEach(movie => movie.classList.remove("selected"));
    button.classList.add("selected");
    chosenMovie = button.dataset.movie;
    document.getElementById("movieError").textContent = "";
  }

  function confirmMovie() {
    if (!chosenMovie) {
      document.getElementById("movieError").textContent = "Выбери один фильм 🙂";
      return;
    }
    const formattedDate = new Date(chosenDate + "T12:00:00").toLocaleDateString("ru-RU", {
      day: "numeric", month: "long", year: "numeric"
    });
    document.getElementById("summary").textContent = "Твой выбор: " + formattedDate + " · " + chosenMovie;
    goTo(6);
  }

  async function shareChoice() {
    const formattedDate = new Date(chosenDate + "T12:00:00").toLocaleDateString("ru-RU", {
      day: "numeric", month: "long", year: "numeric"
    });
    const text = "Я выбрал дату для нашего похода в кино: " + formattedDate + ". Фильм: " + chosenMovie + ".";
    if (navigator.share) {
      try {
        await navigator.share({ title: "Мой выбор для свидания", text });
      } catch (err) {
        // If sharing is cancelled, stay on the final screen.
      }
    } else if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(text);
        alert("Выбор скопирован. Теперь отправь его Лизе в удобном мессенджере.");
      } catch (err) {
        window.prompt("Скопируй и отправь Лизе:", text);
      }
    } else {
      window.prompt("Скопируй и отправь Лизе:", text);
    }
  }
</script>
</body>
</html>
